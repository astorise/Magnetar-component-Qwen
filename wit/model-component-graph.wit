package magnetar:model-component-graph@1.14.0;

/// Runtime-owned graph-builder Capability (`model-component-graph-contract`):
/// a Model Component calls these operations to incrementally describe an
/// ExecutionGraph; the Runtime owns the resulting graph value, its
/// validation, and every identity/reference the Component uses to build it.
interface graph-builder {
  /// Portable per-node attribute value. Mirrors `magnetar-runtime`'s
  /// `OperatorAttributeValue` exactly (Boolean/Integer/Float/String/DType/
  /// Layout) -- not `compute.wit`'s broader `operation-attribute` shape,
  /// since a graph-builder node attribute never carries a full nested
  /// tensor shape or axis list.
  variant attribute-value {
    boolean(bool),
    integer(s64),
    float-value(f64),
    text(string),
  }

  record attribute {
    name: string,
    value: attribute-value,
  }

  /// Which phase this graph is being built for. Matches
  /// `execution-graph`'s `Prefill And Decode Graphs` requirement -- the
  /// Capability only supports these two for graph-builder-produced graphs;
  /// every other `ExecutionGraphPhase` variant remains Runtime-internal.
  enum graph-phase {
    prefill,
    decode,
    /// A bidirectional encoder pass, separate from decoder generation.
    encode,
  }

  enum kv-cache-role {
    k,
    v,
  }

  /// KV involvement for one graph node's output edge. `resource` is always
  /// a Runtime-issued identity from `kv-resource` -- never a
  /// Component-invented string (Requirement "Graph Builder KV Logical
  /// Resources").
  record kv-involvement {
    resource-id: string,
    role: kv-cache-role,
    append: bool,
  }

  /// A tensor's shape, dimensions in order. Deliberately narrower than
  /// `magnetar-runtime`'s full `TensorDescriptor` (dtype/layout/view/
  /// affinity/...) for this first, minimal Component: every tensor this
  /// Capability's graphs carry today is a contiguous `float32` value, the
  /// same simplification the existing Rust-synthesized Qwen fixture graph
  /// already makes. Extending this to a real portable dtype/layout choice
  /// is real follow-up work once a Component genuinely needs one, not a
  /// completed generality this record only pretends to have.
  record tensor-shape {
    dimensions: list<u64>,
  }

  /// Begins building a graph. Must be the first call; only one graph may
  /// be under construction per Component instance at a time. A Component
  /// that violates a graph-builder invariant (calls this twice without an
  /// intervening `finish-graph`, references an edge id that does not
  /// exist, names a weight/KV identity the Runtime does not recognize, ...)
  /// gets a trapped host call, not a recoverable `result` -- these are all
  /// "the Component is not behaving as this contract requires" conditions,
  /// the same fail-closed posture this crate already uses for every other
  /// Provider/Kernel boundary violation. A well-behaved Component never
  /// triggers one.
  begin-graph: func(phase: graph-phase, sequence-length: u64, position-offset: u64);

  /// Declares one graph input edge (e.g. "input.token_ids"), returning the
  /// edge id the Component uses to reference it as a node input. `shape` is
  /// Component-supplied (Requirement "Graph Builder Tensor Descriptors and
  /// Weight References": the Component, which knows the architecture,
  /// supplies the descriptor; the Runtime's job is to validate it, not
  /// invent it from Runtime-side knowledge of the architecture it must not
  /// have).
  declare-input: func(name: string, shape: tensor-shape) -> string;

  /// Resolves a logical weight name (e.g. "layer3.q_proj",
  /// "token_embedding") against the active Model Instance's already-
  /// validated weight resources, returning the edge id to use as a node
  /// input. The Component never supplies or sees a raw resource id or
  /// buffer (Requirement "Graph Builder Tensor Descriptors and Weight
  /// References").
  weight-edge: func(logical-name: string) -> string;

  /// Declares that `edge-id` (a weight edge from `weight-edge`) may alias
  /// `target-logical-name`'s weight edge (tied embeddings).
  alias-weight-edge: func(edge-id: string, target-logical-name: string);

  /// Issues a Runtime-owned KV logical resource identity for `layer`/
  /// `role`, for use in a subsequent `add-node` call's `kv` argument.
  kv-resource: func(layer: u64, role: kv-cache-role) -> string;

  /// Issues an opaque logical identity for a fixed-size recurrent slot at a
  /// particular layer. Slot names are 1-64 ASCII letters, digits, `_` or `-`;
  /// shapes have nonzero fixed dimensions and at most 67,108,864 f32 elements.
  /// The same layer/slot must have the same shape throughout one graph.
  /// These identities describe state, not Provider handles or KV caches.
  /// Added in 1.11.0. Since 1.13.0 the first-native Runtime executes such
  /// graphs: it keeps the state per KV cache, zero for a new sequence, and
  /// commits it with the accepted token (`support-qwen38-flash-next`).
  recurrent-resource: func(layer: u64, slot: string, shape: tensor-shape) -> string;

  /// Declares the prior committed value of a resource as an input edge.
  /// A new sequence starts from zeros. Each resource must have exactly one
  /// consumed input and one same-shaped output in the graph.
  recurrent-input: func(resource-id: string) -> string;

  /// Associates a node's output edge with the next value of a resource.
  /// State is committed only with the accepted token/segment, atomically with
  /// related KV updates; a failure must preserve the previous generation.
  recurrent-output: func(resource-id: string, edge-id: string);

  /// Adds one graph node: `operator`/`family` name a portable Operator
  /// identity (never a Provider-specific Kernel name -- Requirement
  /// "Graph Builder Node and Operator Identity"), `inputs` are edge ids
  /// already returned by a prior `declare-input`/`weight-edge`/`add-node`
  /// call, and `kv` is `some` only for a node whose output participates in
  /// incremental decode. Returns the new node's single output edge id
  /// (single-output only for now -- matches the Runtime's own current
  /// production capability; see
  /// `define-provider-prepared-kernel-execution-contract`'s deferred
  /// multi-output wiring).
  add-node: func(
    node-id: string,
    operator: string,
    family: string,
    attributes: list<attribute>,
    inputs: list<string>,
    output-shape: tensor-shape,
    kv: option<kv-involvement>,
  ) -> string;

  /// Adds one Operator with 1-16 independently addressable output edges.
  /// Output shapes are in Operator order; each returned edge may be consumed
  /// by later nodes or bound as a recurrent output. Unlike `add-node`, this
  /// additive 1.11.0 form does not attach KV metadata. Arity and shapes are
  /// validated against the portable Operator catalog at `finish-graph`.
  add-node-outputs: func(
    node-id: string,
    operator: string,
    family: string,
    attributes: list<attribute>,
    inputs: list<string>,
    output-shapes: list<tensor-shape>,
  ) -> list<string>;

  /// Declares `edge-id` as the graph's output (e.g. "logits"), finalizes
  /// and validates the graph, and returns an opaque graph handle the
  /// Runtime uses to look up the real `ExecutionGraph` it built. No further
  /// calls may target this graph after this one.
  finish-graph: func(output-edge-id: string) -> string;
}

/// Runtime-owned Capability exposing normalized, Runtime-authorized model
/// architecture configuration bound to the active Model Instance
/// (`implement-production-qwen-model-loading` Decision 6). A configurable
/// Model Component queries this to derive weight names/shapes and graph
/// structure instead of hard-coding fixture-specific dimensions. Added in
/// `1.1.0` alongside the unchanged `graph-builder` interface -- a Component
/// compiled against `1.0.0` (importing only `graph-builder`) remains valid;
/// this is a purely additive evolution.
interface model-config {
  /// Runtime-authorized normalized model architecture configuration.
  /// Deliberately narrow: only the specific architecture-shaped values a
  /// Component needs to produce a production-shaped graph -- never raw
  /// JSON, arbitrary annotation maps, a file path, raw weight bytes, or
  /// Provider/Device identity.
  record architecture-config {
    hidden-size: u64,
    intermediate-size: u64,
    num-hidden-layers: u32,
    num-attention-heads: u32,
    num-key-value-heads: u32,
    head-dimension: u64,
    vocabulary-size: u64,
    rms-norm-eps: f64,
    rope-theta: f64,
    rope-scaling-factor: option<f64>,
    tie-word-embeddings: bool,
    /// Whether `self-attn.{q,k,v}-proj` carry an additive bias term -- a
    /// real Qwen2/2.5 architectural default, not config.json-declared.
    /// Added in `1.2.0`: source-additive (a Component's own graph-building
    /// logic need not read this field), but `architecture-config`'s
    /// structural shape changed, so any checked-in *compiled* Component
    /// binary that imports `model-config` must be rebuilt against `1.2.0`
    /// to link -- a `1.1.0`-compiled binary will fail component
    /// instantiation against a `1.2.0` host (a clean, fail-closed link
    /// error), not silently misread this field.
    attention-bias: bool,
  }

  /// Returns the Runtime-authorized architecture configuration bound to
  /// the active Model Instance for this graph-building session. Traps if
  /// none is bound -- the Runtime never fabricates a configuration for a
  /// Component that has no real ingested one (Decision 6's fail-closed
  /// posture, matching `graph-builder`'s own "a well-behaved Component
  /// never triggers one").
  model-config: func() -> architecture-config;

  /// Wavelength-banded RoPE frequency scaling: pairs whose wavelength is
  /// below `original-max-position-embeddings / high-freq-factor` keep their
  /// frequency, those above `original-max-position-embeddings /
  /// low-freq-factor` divide it by `factor`, and the band in between is
  /// interpolated (Hugging Face `rope_type = "llama3"`). Added in `1.4.0`.
  record banded-rope-scaling {
    factor: f64,
    low-freq-factor: f64,
    high-freq-factor: f64,
    original-max-position-embeddings: u64,
  }

  /// YaRN RoPE frequency scaling (Hugging Face `rope_type = "yarn"`). Added
  /// in `1.7.0`. Each rotated pair blends its frequency `f` with
  /// `f / factor` along a ramp whose bounds are the pairs completing
  /// `beta-fast` and `beta-slow` rotations over
  /// `original-max-position-embeddings` positions (widened to whole pairs
  /// when `truncate`); `cos` and `sin` are multiplied by `attention-factor`.
  /// A Component states all of it on its `rope` nodes
  /// (`frequency_scaling = "yarn"`). `mscale-all-dim` is the checkpoint's
  /// own value, for a Component whose model also rescales its attention
  /// softmax by it.
  record yarn-rope-scaling {
    factor: f64,
    original-max-position-embeddings: u64,
    beta-fast: f64,
    beta-slow: f64,
    truncate: bool,
    attention-factor: f64,
    mscale-all-dim: option<f64>,
  }

  /// A per-frequency RoPE scaling scheme the checkpoint declares. Added in
  /// `1.4.0`; new schemes are new cases (`yarn` in `1.7.0`). A Component
  /// compiled against an earlier version cannot receive a newer case: the
  /// call traps instead of returning a scheme it would ignore.
  variant rope-frequency-scaling {
    banded(banded-rope-scaling),
    yarn(yarn-rope-scaling),
  }

  /// Added in `1.4.0`: the per-frequency RoPE scaling the active Model
  /// Instance's checkpoint declares, `none` when it declares none. It is
  /// the Component's to interpret: a Component that understands the scheme
  /// declares it on its `rope` nodes (`frequency_scaling` attributes); one
  /// that does not must refuse to build a graph rather than ignore it.
  /// A new function, not a new `architecture-config` field, so Components
  /// compiled against earlier versions keep linking.
  rope-scaling: func() -> option<rope-frequency-scaling>;

  /// A decoder MLP made of routed experts (`execute-and-cache-moe-experts`
  /// F02). Added in `1.5.0`.
  record moe-config {
    /// Routed experts per layer.
    experts: u32,
    /// Experts each token is routed to.
    experts-per-token: u32,
    /// Each routed expert's intermediate size.
    expert-intermediate-size: u64,
    /// The always-active shared expert's intermediate size, if any.
    shared-expert-intermediate-size: option<u64>,
    /// Whether the chosen experts' probabilities are renormalized to sum
    /// to one.
    normalize-top-k: bool,
  }

  /// Added in `1.5.0`: the mixture of experts every decoder layer's MLP is,
  /// `none` for a dense checkpoint. A Component that does not understand a
  /// declared mixture of experts must refuse to build a graph rather than
  /// build a dense one. A new function, not a new `architecture-config`
  /// field, so Components compiled against earlier versions keep linking.
  mixture-of-experts: func() -> option<moe-config>;

  /// One decoder layer's attention and feed-forward geometry. Added in
  /// `1.6.0`. Family-neutral: it describes what differs *between layers* of a
  /// checkpoint (sliding vs. full attention, head widths, KV head counts,
  /// RoPE per attention kind, shared KV, feed-forward width), not any model
  /// family. The Runtime derives every field from the checkpoint's
  /// configuration; a Component never recomputes a per-layer rule.
  record layer-spec {
    /// Look-back window in tokens; `none` attends over the whole context.
    sliding-window: option<u32>,
    /// Width of one attention head in this layer.
    head-dimension: u64,
    /// Key/value heads in this layer.
    num-key-value-heads: u32,
    /// RoPE base of this layer.
    rope-theta: f64,
    /// Fraction of each head that is rotated, the rest staying
    /// position-independent; `none` rotates the whole head.
    partial-rotary-factor: option<f64>,
    /// The layer has no value projection: V is derived from the raw key
    /// projection.
    value-from-key: bool,
    /// The layer computes no K/V of its own and attends over those of this
    /// earlier layer, which must have the same head width and KV head count.
    kv-source-layer: option<u32>,
    /// Width of the layer's dense feed-forward.
    intermediate-size: u64,
  }

  /// Added in `1.6.0`: one `layer-spec` per decoder layer
  /// (`num-hidden-layers` entries), `none` for a checkpoint whose layers are
  /// uniform and fully described by `architecture-config`. A Component that
  /// needs a layout and gets `none` must refuse to build a graph.
  layer-layout: func() -> option<list<layer-spec>>;

  /// Checkpoint-wide options `architecture-config` cannot carry. Added in
  /// `1.6.0`.
  record architecture-options {
    /// `cap * tanh(logits / cap)` applied to the logits.
    final-logit-softcapping: option<f64>,
    /// Width of the per-layer input embeddings, `none` for none. A Component
    /// that does not implement them must refuse to build a graph.
    per-layer-input-size: option<u32>,
  }

  options: func() -> architecture-options;

  /// Multi-head latent attention. Added in `1.7.0`. Queries come from a
  /// `q-lora-rank`-wide low-rank projection when it is set, else from the
  /// hidden state directly; keys and values from a `kv-lora-rank`-wide
  /// latent. Each query/key head is `qk-nope-head-dim` position-independent
  /// values followed by `qk-rope-head-dim` rotated ones, the rotated key part
  /// being one head shared by every head; each value head is `v-head-dim`
  /// wide. `architecture-config.head-dimension` is then
  /// `qk-nope-head-dim + qk-rope-head-dim`, and its `num-key-value-heads` the
  /// number of attention heads.
  record mla-config {
    q-lora-rank: option<u32>,
    kv-lora-rank: u32,
    qk-nope-head-dim: u64,
    qk-rope-head-dim: u64,
    v-head-dim: u64,
  }

  /// Added in `1.7.0`: the latent attention every layer uses, `none` for
  /// ordinary attention. A Component that does not implement it must refuse
  /// to build a graph; the Runtime also refuses a graph built without
  /// reading this function when it is not `none`.
  multi-head-latent-attention: func() -> option<mla-config>;

  /// Added in `1.7.0`: one entry per decoder layer, `true` where the layer's
  /// MLP is the declared `mixture-of-experts` and `false` where it is a dense
  /// MLP of `intermediate-size`; `none` when every layer's MLP is the
  /// mixture of experts (the `1.5.0` meaning). The Runtime refuses a graph
  /// built without reading this function when it is not `none`.
  mixture-of-experts-layers: func() -> option<list<bool>>;

  /// How router logits become expert scores. Added in `1.7.0`.
  enum expert-scoring {
    softmax,
    sigmoid,
  }

  /// How a group of experts is scored for group-limited routing. Added in
  /// `1.7.0`.
  enum expert-group-score {
    /// Its best expert's score.
    max,
    /// The sum of its two best experts' scores.
    top-two-sum,
  }

  /// Group-limited routing: the experts form `count` equal groups, and a
  /// token's experts come from its `per-token` best groups only. Added in
  /// `1.7.0`.
  record expert-groups {
    count: u32,
    per-token: u32,
    score: expert-group-score,
  }

  /// How tokens are routed to the experts. Added in `1.7.0`.
  record expert-routing-config {
    scoring: expert-scoring,
    groups: option<expert-groups>,
    /// The factor on the chosen experts' combination weights.
    routed-scaling-factor: f64,
    /// A per-expert bias is added to the scores to choose the experts, not
    /// to weight them.
    selection-bias: bool,
    /// Whether the shared expert's output passes through a sigmoid gate.
    shared-expert-gated: bool,
  }

  /// Added in `1.7.0`: the routing of the declared `mixture-of-experts`.
  /// `none` keeps the `1.5.0` routing: a softmax over every expert, no
  /// groups, unscaled weights, no selection bias, and a gated shared expert
  /// when the mixture declares one. The Runtime refuses a graph built
  /// without reading this function when it is not `none`.
  expert-routing: func() -> option<expert-routing-config>;

  /// Added in 1.8.0. The checkpoint's normalized MLP activation; `none`
  /// means the source did not establish it. A Component must reject an
  /// unknown value or an activation its graph does not implement.
  hidden-activation: func() -> option<string>;

  /// Explicit per-layer Q/K rotary selection, added in 1.9.0. Each entry
  /// is true for RoPE and false for position-independent Q/K; the list has
  /// exactly num-hidden-layers entries. None uses the Component's baseline.
  rope-layers: func() -> option<list<bool>>;

  /// Explicit normalization of selected expert scores, added in 1.10.0.
  /// `multiple-experts` leaves top-1 unnormalized; `always` normalizes it.
  enum expert-normalization-mode {
    never,
    multiple-experts,
    always,
  }

  /// `none` keeps the older Component contract's behavior. A Component
  /// must read a declared value and reject one its graph cannot implement.
  expert-normalization: func() -> option<expert-normalization-mode>;

  /// Epsilon of the query and KV latent bottleneck normalizations, when
  /// different from the decoder-wide epsilon. Added in 1.10.0; `none` keeps
  /// the earlier Component behavior. A declared value must be read.
  latent-norm-epsilon: func() -> option<f64>;

  /// One bidirectional encoder layer, in checkpoint order. The local radius
  /// is symmetric and inclusive; none means global attention.
  record encoder-layer-config {
    local-radius: option<u32>,
    rope-theta: f64,
    attention-normalization: bool,
  }

  /// Geometry not represented by the decoder architecture record. Token
  /// positions are physical zero-based indices in this initial profile.
  record encoder-settings {
    norm-epsilon: f64,
    max-positions: u64,
    norm-bias: bool,
    attention-bias: bool,
    mlp-bias: bool,
    layers: list<encoder-layer-config>,
  }

  /// Added in 1.12.0. A declared encoder configuration must be read by its
  /// Component before a graph is accepted; older Components cannot ignore it.
  encoder-config: func() -> option<encoder-settings>;

  /// The gated-delta linear attention layers of a hybrid decoder (Qwen3.5).
  /// Added in 1.13.0. A linear layer mixes tokens with a `gated-delta-mixer`
  /// whose convolution and recurrent states are recurrent resources; it has
  /// no KV history. The other layers are full attention.
  record linear-attention-config {
    /// One entry per decoder layer: true for a linear layer.
    layers: list<bool>,
    key-heads: u32,
    value-heads: u32,
    key-head-dimension: u64,
    value-head-dimension: u64,
    conv-kernel: u32,
  }

  /// Added in 1.13.0: `none` when every layer is full attention. A declared
  /// value must be read before a graph is accepted.
  linear-attention: func() -> option<linear-attention-config>;

  /// Decoder forms `architecture-config` cannot carry. Added in 1.13.0.
  record decoder-variant-config {
    /// Every decoder RMSNorm scales by `norm-weight-offset + weight`
    /// (Qwen3.5's zero-centered norms: 1). The linear-attention mixer's
    /// gated norm keeps its plain weight.
    norm-weight-offset: f64,
    /// Each attention head's query projection is followed by a gate of the
    /// same width; the attention output is multiplied by its sigmoid.
    attention-output-gate: bool,
  }

  /// Added in 1.13.0: `none` keeps the plain forms. A declared value must
  /// be read before a graph is accepted.
  decoder-variants: func() -> option<decoder-variant-config>;

  /// Several residual streams mixed by learned gates (Qwen4-Exp's
  /// hyper-connections). Added in 1.14.0. The embedding is repeated
  /// `streams` times along the feature axis; each block reads a gated mix
  /// of the streams and writes back to every stream through its own
  /// injection weight. There is no input or post-attention norm, and the
  /// final mix feeds the LM head directly.
  record hyper-connection-config {
    streams: u32,
    /// Rank of the low-rank input mixer.
    lowrank: u32,
  }

  /// Added in 1.14.0: `none` keeps a single residual stream. A declared
  /// value must be read before a graph is accepted.
  hyper-connections: func() -> option<hyper-connection-config>;

  /// Hashed n-gram embeddings added before some layers' first block
  /// (Qwen4-Exp's per-layer embeddings). Added in 1.14.0.
  record ngram-embedding-config {
    /// One entry per decoder layer: true where the layer adds its
    /// embedding.
    layers: list<bool>,
    /// Width of the concatenated heads' embeddings.
    embedding-dim: u64,
    /// Kernel of the dilated depthwise convolution (the dilation is
    /// `ngram-size`).
    conv-kernel: u32,
    /// The largest n-gram order.
    ngram-size: u32,
    /// Independently hashed heads per n-gram order.
    heads-per-ngram: u32,
    /// Lower bound of each head's prime vocabulary.
    vocabulary-base: u64,
    /// The combined vocabulary is padded to a multiple of this.
    vocabulary-multiple: u32,
    /// Seed of the hash multipliers.
    seed: u64,
    /// The token that delimits segments.
    eos-token: u32,
  }

  /// Added in 1.14.0: `none` when no layer adds an n-gram embedding. A
  /// declared value must be read before a graph is accepted.
  ngram-embeddings: func() -> option<ngram-embedding-config>;

  /// A token indexer chooses, for each query, the blocks of keys a
  /// full-attention layer reads (Qwen4-Exp's QSA). Added in 1.14.0.
  record token-selection-config {
    /// Indexer query heads.
    heads: u32,
    /// Indexer key heads (one).
    key-heads: u32,
    /// Width of an indexer head.
    head-dimension: u64,
    /// Tokens selected from complete blocks.
    budget: u32,
    /// Tokens averaged into one block.
    compress-ratio: u32,
  }

  /// Added in 1.14.0: `none` when every full-attention layer reads every
  /// earlier key. A declared value must be read before a graph is
  /// accepted.
  token-selection: func() -> option<token-selection-config>;

  /// The activation of a gate that scales a normalized value.
  enum gate-activation {
    silu,
    sigmoid,
  }

  /// The activation of the linear-attention layers' output gate. Added in
  /// 1.14.0: `none` keeps `silu`. A declared value must be read before a
  /// graph is accepted.
  linear-attention-gate: func() -> option<gate-activation>;
}

/// A separate graph-producing world for one bidirectional encoder pass.
/// Inputs are token IDs and a binary key mask; the output is per-token
/// hidden states. It does not expose generation or decoder KV semantics.
world encoder-component-graph-producer {
  import graph-builder;
  import model-config;
  export build-encoder-graph: func(sequence-length: u64) -> string;
}

/// World a Model Component satisfies to produce graphs through this
/// Capability instead of a Runtime-internal, model-family-specific
/// builder (Requirement "Model Component Graph Contract").
world model-component-graph-producer {
  import graph-builder;
  import model-config;

  /// Builds and returns a prefill-phase graph handle for `sequence-length`
  /// tokens (`finish-graph`'s return value).
  export build-prefill-graph: func(sequence-length: u64) -> string;

  /// Builds and returns a decode-phase graph handle, given
  /// `cached-token-count` prior tokens already committed to KV state.
  export build-decode-graph: func(cached-token-count: u64) -> string;

  /// Added in `1.3.0` (`add-real-multi-device-model-instance-placement`):
  /// builds one *segment* of the full decoder stack's prefill graph --
  /// real decoder layers `[start-layer, end-layer)` only, for real
  /// multi-Device pipeline placement (a caller runs one segment's graph
  /// on one Device, then another segment's graph on a different Device).
  /// `build-prefill-graph(sequence-length)` is exactly
  /// `build-prefill-graph-segment(sequence-length, 0, num-hidden-layers)`
  /// -- source-identical, not merely output-equivalent.
  ///
  /// When `start-layer` is `0`, the segment begins from a declared
  /// `token_ids` input, including the real token embedding lookup (as
  /// `build-prefill-graph` does today). Otherwise it begins from a
  /// declared `hidden_states_in` input of shape `[sequence-length,
  /// hidden-size]`, carrying a prior segment's own real output.
  ///
  /// When `end-layer` equals the active Model Instance's real
  /// `num-hidden-layers` (from `model-config`), the segment ends with the
  /// real final-norm/lm-head projection, exactly as
  /// `build-prefill-graph` does today. Otherwise it ends with the raw
  /// post-layer hidden state as the graph's own declared output, for a
  /// subsequent segment to consume as its own `hidden_states_in`.
  ///
  /// `0 <= start-layer <= end-layer <= num-hidden-layers` is a real,
  /// Runtime-validated precondition; a Component that violates it (by
  /// calling with an inverted or out-of-range pair) traps, matching this
  /// interface's existing fail-closed posture -- a well-behaved Component
  /// never triggers one.
  export build-prefill-graph-segment: func(sequence-length: u64, start-layer: u32, end-layer: u32) -> string;

  /// The decode-phase counterpart of `build-prefill-graph-segment`, with
  /// the identical segment-boundary semantics.
  /// `build-decode-graph(cached-token-count)` is exactly
  /// `build-decode-graph-segment(cached-token-count, 0,
  /// num-hidden-layers)`.
  export build-decode-graph-segment: func(cached-token-count: u64, start-layer: u32, end-layer: u32) -> string;
}
